<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>Cookies</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/Cookies</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <!-- Must stay on the FluentMigrator major Ranks exports via resources/exports; SwiftlyS2 binds every plugin to that copy. -->
    <PackageReference Include="FluentMigrator" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Core" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.MySql" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <!-- No direct Microsoft.Extensions.* references: SwiftlyS2.CS2 brings them at the version SwiftlyS2
         itself builds against, and pinning them here fails restore (NU1605) whenever the SDK raises them. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="1.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Cookies.Contract/Cookies.Contract.csproj" />
  </ItemGroup>

  <Target Name="CopyContractToExports" AfterTargets="Build">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)../Cookies.Contract/build/$(TargetFramework)/Cookies.Contract.dll" DestinationFolder="$(MSBuildThisFileDirectory)resources/exports/" />
	</Target>

  <Target Name="CopyContractToExports" AfterTargets="Publish">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)../Cookies.Contract/build/$(TargetFramework)/Cookies.Contract.dll" DestinationFolder="$(PublishDir)resources/exports/" />
	</Target>

  <Target Name="CreateZip" AfterTargets="Publish">
    <ItemGroup>
      <PublishFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>
    
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project> 